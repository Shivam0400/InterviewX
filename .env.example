# ==============================================================================
# InterviewX — Environment Configuration Template
# ==============================================================================

# Database URL
# For local zero-config SQLite:
DATABASE_URL="file:./dev.db"
# For PostgreSQL (e.g. Supabase, Neon, AWS RDS):
# DATABASE_URL="postgresql://postgres:password@localhost:5432/interviewx?schema=public"

# Authentication & Session Security
# Generate a secure 32+ character random string in production (e.g. openssl rand -base64 32)
AUTH_SECRET="interviewx-super-secret-development-key-replace-in-production-32chars"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Code Execution Engine — Judge0 Integration
# Can be official Judge0 CE (https://judge0-ce.p.rapidapi.com or self-hosted)
# If left empty, InterviewX safely falls back to its built-in isolated execution engine.
JUDGE0_API_URL=""
JUDGE0_API_KEY=""
JUDGE0_API_HOST="judge0-ce.p.rapidapi.com"

# AI Interview Copilot — LLM Integration
# Set your Gemini API key (or OpenAI compatible key)
# If empty, InterviewX uses its built-in heuristic analysis engine.
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Application Environment
NODE_ENV="development"
